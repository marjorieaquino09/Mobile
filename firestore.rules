rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownedByCaller() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function incomingOwnedByCaller() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSelf(userId);

      match /inventory/{productId} {
        allow read, write: if isSelf(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /orders/{orderId} {
      allow read, delete: if ownedByCaller();
      allow create: if incomingOwnedByCaller();
      allow update: if ownedByCaller() && incomingOwnedByCaller();
    }

    match /credits/{creditId} {
      allow read, delete: if ownedByCaller();
      allow create: if incomingOwnedByCaller();
      allow update: if ownedByCaller()
        && request.resource.data.userId == resource.data.userId;
    }

    // Shared recommended catalog — read-only from the app.
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Legacy top-level inventory is no longer used by the app.
    match /inventory/{itemId} {
      allow read, write: if false;
    }
  }
}
